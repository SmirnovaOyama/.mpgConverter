{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../src/banner.ts",
    "../src/presets.ts",
    "../src/errors.ts",
    "../src/types.ts"
  ]
}
